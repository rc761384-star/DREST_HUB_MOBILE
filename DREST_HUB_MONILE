local ActiveTouches = {}
local ThreeFingerLatched = false

local function TogglePanelByThreeFingers()
	Main.Visible = not Main.Visible
	ThreeFingerLatched = true
end

UserInputService.TouchStarted:Connect(function(Input)
	ActiveTouches[Input] = true

	local Count = 0
	for _ in pairs(ActiveTouches) do
		Count += 1
	end

	if Count >= 3 and not ThreeFingerLatched then
		TogglePanelByThreeFingers()
	end
end)

UserInputService.TouchEnded:Connect(function(Input)
	ActiveTouches[Input] = nil

	local Count = 0
	for _ in pairs(ActiveTouches) do
		Count += 1
	end

	if Count < 3 then
		ThreeFingerLatched = false
	end
end)

