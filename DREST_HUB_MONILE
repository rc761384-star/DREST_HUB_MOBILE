local function CreateESP(Character, DisplayName)

	if not Character then
		return
	end

	if Character == LocalPlayer.Character then
		return
	end

	if ESPObjects[Character] then
		return
	end

	if not IsCharacterValid(Character) then
		return
	end

	local Box = Instance.new("Frame")
	Box.Name = "ESP_BOX"
	Box.AnchorPoint = Vector2.new(0.5, 0.5)
	Box.BackgroundTransparency = 1
	Box.BorderSizePixel = 2
	Box.BorderColor3 = Color3.fromRGB(120, 140, 255)
	Box.Visible = false
	Box.ZIndex = 20
	Box.Parent = ScreenGui

	local NameLabel = Instance.new("TextLabel")
	NameLabel.Name = "ESP_NAME"
	NameLabel.AnchorPoint = Vector2.new(0.5, 1)
	NameLabel.BackgroundTransparency = 1
	NameLabel.Text = DisplayName or Character.Name
	NameLabel.TextColor3 = Color3.fromRGB(120, 140, 255)
	NameLabel.TextStrokeTransparency = 0.25
	NameLabel.Font = Enum.Font.GothamBold
	NameLabel.TextSize = 12
	NameLabel.TextXAlignment = Enum.TextXAlignment.Center
	NameLabel.Visible = false
	NameLabel.ZIndex = 21
	NameLabel.Parent = ScreenGui

	local DistanceLabel = Instance.new("TextLabel")
	DistanceLabel.Name = "ESP_DISTANCE"
	DistanceLabel.AnchorPoint = Vector2.new(0.5, 0)
	DistanceLabel.BackgroundTransparency = 1
	DistanceLabel.Text = ""
	DistanceLabel.TextColor3 = Color3.fromRGB(120, 140, 255)
	DistanceLabel.TextStrokeTransparency = 0.3
	DistanceLabel.Font = Enum.Font.Gotham
	DistanceLabel.TextSize = 10
	DistanceLabel.TextXAlignment = Enum.TextXAlignment.Center
	DistanceLabel.Visible = false
	DistanceLabel.ZIndex = 21
	DistanceLabel.Parent = ScreenGui

	ESPObjects[Character] = {
		Box = Box,
		Name = NameLabel,
		Distance = DistanceLabel
	}
end

local function RemoveESP(Character)

	local Data = ESPObjects[Character]

	if not Data then
		return
	end

	if Data.Box then
		Data.Box:Destroy()
	end

	if Data.Name then
		Data.Name:Destroy()
	end

	if Data.Distance then
		Data.Distance:Destroy()
	end

	ESPObjects[Character] = nil
end

local function ScanCharacters()

	for _, Player in ipairs(Players:GetPlayers()) do

		if Player ~= LocalPlayer then

			local Character = Player.Character

			if Character then
				CreateESP(
					Character,
					Player.DisplayName
				)
			end
		end
	end

	for _, Object in ipairs(workspace:GetChildren()) do

		if Object:IsA("Model")
			and Object ~= LocalPlayer.Character
			and not Players:GetPlayerFromCharacter(Object)
			and Object:FindFirstChildOfClass("Humanoid") then

			CreateESP(
				Object,
				Object.Name
			)
		end
	end
end

--==================================================
-- UPDATE SCREEN ESP
--==================================================

local function UpdateESP(Camera)

	for Character, Data in pairs(ESPObjects) do

		if not Character.Parent then

			RemoveESP(Character)

			continue
		end

		if not IsCharacterValid(Character) then

			Data.Box.Visible = false
			Data.Name.Visible = false
			Data.Distance.Visible = false

			continue
		end

		if not Settings.ESPEnabled then

			Data.Box.Visible = false
			Data.Name.Visible = false
			Data.Distance.Visible = false

			continue
		end

		local Root = GetRoot(Character)
		local Head = Character:FindFirstChild("Head")

		if not Root then
			continue
		end

		if not Head then
			Head = Root
		end

		local RootPosition, RootVisible =
			Camera:WorldToViewportPoint(
				Root.Position
			)

		local HeadPosition, HeadVisible =
			Camera:WorldToViewportPoint(
				Head.Position + Vector3.new(0, 0.25, 0)
			)

		if not RootVisible
			or not HeadVisible
			or RootPosition.Z <= 0
			or HeadPosition.Z <= 0 then

			Data.Box.Visible = false
			Data.Name.Visible = false
			Data.Distance.Visible = false

			continue
		end

		local RootScreen =
			Vector2.new(
				RootPosition.X,
				RootPosition.Y
			)

		local HeadScreen =
			Vector2.new(
				HeadPosition.X,
				HeadPosition.Y
			)

		local Height =
			math.abs(
				RootScreen.Y - HeadScreen.Y
			) * 2.4

		Height = math.clamp(
			Height,
			35,
			600
		)

		local Width =
			math.clamp(
				Height * 0.55,
				22,
				330
			)

		local CenterX =
			(RootScreen.X + HeadScreen.X) / 2

		local CenterY =
			(HeadScreen.Y + RootScreen.Y) / 2

		local Distance =
			(Camera.CFrame.Position - Root.Position).Magnitude

		local ESPColor

		if Settings.RainbowESP then
			ESPColor =
				Color3.fromHSV(
					(os.clock() * 0.25) % 1,
					0.85,
					1
