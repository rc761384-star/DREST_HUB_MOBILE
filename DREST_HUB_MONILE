local function CreateButton(Parent, Text, Callback)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -4, 0, 38)
	Button.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
	Button.BorderSizePixel = 0
