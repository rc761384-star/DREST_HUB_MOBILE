local function GetTargetPart(Character)

	if Settings.Target == "HEAD" then

		return Character:FindFirstChild("Head")

	elseif Settings.Target == "CHEST" then

		return Character:FindFirstChild("UpperTorso")
			or Character:FindFirstChild("Torso")
			or Character:FindFirstChild("HumanoidRootPart")

	elseif Settings.Target == "ROOT" then

		return Character:FindFirstChild(
			"HumanoidRootPart"
		)
	end

	return Character:FindFirstChild("Head")
end

local function FindTarget(Camera)

	local BestPart = nil
	local BestDistance = math.huge

	local Viewport =
		Camera.ViewportSize

	local Center =
		Vector2.new(
			Viewport.X / 2,
			Viewport.Y / 2
		)

	for _, Player in ipairs(Players:GetPlayers()) do

		if Player ~= LocalPlayer then

			local Character = Player.Character

			if Character
				and IsCharacterValid(Character) then

				local Root =
					GetRoot(Character)

				local TargetPart =
					GetTargetPart(Character)

				if Root and TargetPart then

					local WorldDistance =
						(
							Camera.CFrame.Position
							- Root.Position
						).Magnitude

					if WorldDistance <= Settings.Distance then

						local ScreenPosition, Visible =
							Camera:WorldToViewportPoint(
								TargetPart.Position
							)

						if Visible
							and ScreenPosition.Z > 0 then

							local ScreenPoint =
								Vector2.new(
									ScreenPosition.X,
									ScreenPosition.Y
								)

							local ScreenDistance =
								(
									ScreenPoint
									- Center
								).Magnitude

							if ScreenDistance <= Settings.FOV
								and ScreenDistance < BestDistance then

								BestDistance =
									ScreenDistance

								BestPart =
									TargetPart
							end
						end
					end
				end
			end
		end
	end

	return BestPart
end

local function AimAt(Camera, TargetPart)

	if not TargetPart then
		return
	end

	local CurrentPosition =
		Camera.CFrame.Position

	local DesiredCFrame =
		CFrame.lookAt(
			CurrentPosition,
			TargetPart.Position
		)

	local Alpha =
		math.clamp(
			Settings.Smoothness / 100,
			0.01,
			1
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			DesiredCFrame,
			Alpha
		)
end

