local ScanCounter = 0

RunService:BindToRenderStep(
	"DREST_HUB_UPDATE",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		local Camera =
			workspace.CurrentCamera

		if not Camera then
			return
		end

		-- FOV

		FOVCircle.Visible =
			Settings.ShowFOV

		FOVCircle.Size =
			UDim2.fromOffset(
				Settings.FOV * 2,
				Settings.FOV * 2
			)

		if Settings.FOVRainbow then

			FOVStroke.Color =
				Color3.fromHSV(
					(os.clock() * 0.25) % 1,
					0.85,
					1
				)

		else

			FOVStroke.Color =
				Color3.fromRGB(
					120,
					140,
					255
				)
		end

		-- MOVEMENT

		UpdateMovement()

		-- SCAN

		ScanCounter += 1

		if ScanCounter >= 15 then

			ScanCounter = 0

			ScanCharacters()
		end

		-- ESP

		UpdateESP(Camera)

		-- AIM

		if Settings.Aimbot
			or Settings.AimLock then

			local Target =
				FindTarget(Camera)

			if Target then
				AimAt(
					Camera,
					Target
				)
			end
		end
	end
)

